# ===========================================
# Collabix Frontend - Environment Template
# Copy to .env.local for local development.
# This file is documentation only.
# ===========================================

# Backend REST API base URL (axios baseURL).
# Local dev: leave unset -> falls back to relative /api (Vite proxy).
# Production: full URL of the Render backend, e.g.
#   https://collabix-backend.onrender.com/api
VITE_API_BASE_URL=http://localhost:8081/api

# Axios request timeout in milliseconds.
VITE_API_TIMEOUT=30000
