###########################################################

# =========================================================
# LOCAL DEVELOPMENT (.env)
# Copy this file to .env and fill in the values.
# =========================================================

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

###########################################################

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

###########################################################

# Authentication
JWT_SECRET=

###########################################################

# Account activation
# Public frontend origin; do not include /activate.
ACTIVATION_BASE_URL=http://localhost:5173

###########################################################

# SMTP mail
# For Gmail, MAIL_PASSWORD must be a Google App Password, not your normal password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Collabix
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true
MAIL_STARTTLS_REQUIRED=true
MAIL_SSL_ENABLE=false

###########################################################

# =========================================================
# RAILWAY DEPLOYMENT (set these in Railway -> Variables)
# =========================================================
# Railway auto-injects:
#   PORT  -> server.port (already read via ${PORT:8081})
#   DATABASE_URL  -> postgresql://user:pass@host:5432/dbname
#
# Spring Boot needs a JDBC URL, so set SPRING_DATASOURCE_URL
# from the Railway database (prefix the value with "jdbc:").
# =========================================================

SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://host:5432/dbname

# Public frontend origin(s), comma-separated.
CORS_ORIGIN=https://collabix-chi.vercel.app

# Origins allowed to connect to the API (CSP connect-src), space-separated.
CSP_CONNECT_SRC=https://collabix-chi.vercel.app https://collabix-production-eead.up.railway.app

# Comma-separated WebSocket allowed origins (defaults include *.vercel.app and *.collabix.app).
WEBSOCKET_ALLOWED_ORIGINS=https://collabix.up.railway.app

# Same keys as local above (GEMINI_API_KEY, GROQ_API_KEY, JWT_SECRET,
# MAIL_*, ACTIVATION_BASE_URL=https://collabix.up.railway.app)
